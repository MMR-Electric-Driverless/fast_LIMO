<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fast_limo</name>
  <version>0.0.0</version>
  <description>The fast_limo package in ROS2</description>

  <maintainer email="leo.nels.2000@gmail.com">leonardo nels</maintainer>

  <license>Apache License 3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <build_depend condition="$RMW_FASTRTPS_USE_QOS_FROM_XML == 1">mmr_base</build_depend>
  <exec_depend condition="$RMW_FASTRTPS_USE_QOS_FROM_XML == 1">mmr_base</exec_depend>
  <!-- Same package, different flag: LATENCY_TESTING publishes
       mmr_base/LatencySample. Declared separately so either flag alone pulls it in. -->
  <build_depend condition="$LATENCY_TESTING == 1">mmr_base</build_depend>
  <exec_depend condition="$LATENCY_TESTING == 1">mmr_base</exec_depend>

  <!-- BARQ shared-memory transport. Not on rosdep or apt: built from source in
       the same workspace (see the CMakeLists block for the clone URL). -->
  <build_depend condition="$ENABLE_BARQ == 1">barq</build_depend>
  <exec_depend condition="$ENABLE_BARQ == 1">barq</exec_depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>